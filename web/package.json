{
  "name": "delphi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DELPHI / Dự báo — frontend PWA (khung kỹ thuật, UI thật ở GĐ5)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "mascot": "node scripts/paint-mascot.mjs && node scripts/gen-icons.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo:dev": "vite --config vite.demo.dev.config.ts",
    "demo:build": "vite build --config vite.demo.config.ts",
    "demo:deploy": "npx wrangler deploy -c wrangler.demo.jsonc",
    "demo:preview": "vite preview --config vite.demo.config.ts --port 5190 --strictPort"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@fontsource-variable/handjet": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tanstack/react-query": "^5.80.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "buffer": "6.0.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4"
  }
}
