{
  "name": "delphi",
  "version": "0.1.0",
  "private": true,
  "description": "Delphi — a behavioural-finance measurement game (PWA + Hono API + Postgres), built spec-first.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:dev": "tsx scripts/dev_db.ts",
    "migrate": "tsx scripts/migrate.ts",
    "kiem:cot-pfm": "tsx scripts/kiem_cot_pfm_cua.ts",
    "bootstrap:genesis": "tsx scripts/bootstrap_genesis.ts",
    "backup:now": "tsx scripts/backup_now.ts",
    "seed:dev": "tsx scripts/seed_dev.ts",
    "audit:supply": "tsx scripts/audit_supply.ts",
    "audit:cung": "tsx scripts/audit_vat.ts",
    "quy-cho:nap": "tsx scripts/nap_quy_cho.ts",
    "dieu-phoi": "tsx scripts/bat_dieu_phoi.ts",
    "dev:api": "tsx scripts/dev_api.ts",
    "web:dev": "npm --prefix web run dev",
    "web:test": "npm --prefix web run test",
    "web:build": "npm --prefix web run build",
    "lint:css-anim": "tsx scripts/lint_css_anim.ts",
    "lint:pixel-art": "tsx scripts/lint_pixel_art.ts",
    "lint:pool-lock": "tsx scripts/lint_pool_lock.ts",
    "lint:mui-gio": "tsx scripts/lint_mui_gio.ts",
    "lint:thu-tu-khoa": "tsx scripts/lint_thu_tu_khoa.ts",
    "audit:regime": "tsx scripts/audit_regime.ts",
    "art:bang": "tsx scripts/lint_pixel_art.ts --bang",
    "gate": "tsx scripts/holdem_montecarlo.ts",
    "do:chu-ky-thuc-te": "tsx scripts/do_chu_ky_thuc_te.ts",
    "do:ban-tap": "tsx scripts/do_ban_tap_tron.ts",
    "do:consent": "tsx scripts/do_consent.ts",
    "dem:nguoi": "tsx scripts/dem_nguoi.ts",
    "khoi-phuc": "tsx scripts/khoi_phuc.ts",
    "test": "vitest run",
    "test:conc:x3": "vitest run tests/concurrency.test.ts && vitest run tests/concurrency.test.ts && vitest run tests/concurrency.test.ts",
    "typecheck": "tsc --noEmit",
    "pixel:hibit": "tsx scripts/pixel_hibit.ts",
    "pixel:anh": "tsx scripts/pixel_hibit.ts",
    "pixel:sau": "tsx scripts/pixel_hibit.ts --do-bong",
    "tiem": "tsx scripts/tiem.ts",
    "route:ghi": "tsx scripts/sinh_route.ts --ghi",
    "route:kiem": "tsx scripts/sinh_route.ts --kiem",
    "erd:ghi": "tsx scripts/sinh_erd.ts --ghi",
    "erd:kiem": "tsx scripts/sinh_erd.ts --kiem",
    "kinh-te:sim": "tsx scripts/economy_sim.ts",
    "do:pfm-dong-bo": "tsx scripts/do_pfm_dong_bo.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/node": "^10.66.0",
    "dotenv": "^17.2.1",
    "hono": "^4.13.12",
    "nodemailer": "^10.0.13",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "@vercel/node": "^5.8.26",
    "embedded-postgres": "17.10.0-beta.17",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "license": "UNLICENSED"
}
