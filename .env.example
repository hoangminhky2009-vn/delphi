# ============ MÁY FOUNDER (local) ============
# Môi trường: dev | test | production
APP_ENV=dev

# Chuỗi kết nối PostgreSQL.
# Dev local (embedded Postgres, chạy `npm run db:dev` ở terminal riêng trước):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5544/delphi_dev
# MAIL_LOG_BODY=1 ⇒ máy dev in CẢ thân thư (link xác minh / đặt lại có token) ra console. Mặc định ẩn (B10).
MAIL_LOG_BODY=
# DEM_NOI_BO_EMAIL = email tài khoản NỘI BỘ (đội · người thân), phẩy ngăn — `npm run dem:nguoi:prod` trừ khỏi
#                    "người thật". Đặt ở .env.prod, KHÔNG commit danh sách thật (C7).
DEM_NOI_BO_EMAIL=

# Khi migrate/audit lên Supabase PROD từ máy này: thay DATABASE_URL bằng
# "Session pooler" connection string (Dashboard → Connect → Session pooler),
# điền mật khẩu DB của bạn vào chỗ [YOUR-PASSWORD]. KHÔNG commit file .env.
# DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-<region>.pooler.supabase.com:5432/postgres

# ============ ENV TRÊN VERCEL (đặt trong Vercel Dashboard, KHÔNG đặt ở đây) ============
# DATABASE_URL    = Transaction pooler URL (port 6543) — serverless bắt buộc dùng pooler
# TICK_SECRET     = chuỗi ngẫu nhiên dài (xem docs/deploy_gd0.md cách tạo)
# ALLOWED_ORIGIN  = https://<ten-project>.pages.dev  (origin của frontend)
# CANH_WEB_ORIGIN = (tuỳ chọn) origin web mà GET /api/v1/canh đọc /phien-ban.json để so bản; vắng ⇒ origin đầu của ALLOWED_ORIGIN.
# SENTRY_DSN      = DSN của project Sentry — CHUÔNG BÁO LỖI SERVER (D93, 16/08).
#                   Vắng ⇒ kênh im, app chạy y hệt (lỗi chỉ ra Vercel logs).
#                   Có ⇒ mọi lỗi 500 + backup hỏng gửi Sentry, email về founder.
#                   ĐÃ ĐẶT trên Vercel 16/08 (org <sentry-org>, project delphi-api).
#                   Kiểm: curl -H "x-tick-secret: …" /api/v1/health →
#                   bao_loi.noi_ra_ngoai=true (D444: khoá này ở phần CHI TIẾT,
#                   không header thì /health chỉ trả {status, ban_phat_hanh}).
#                   ⚠ Trước D93 biến này được ghi ở đây mà KHÔNG code nào đọc.
#                   Sentry Developer = 0đ, không thẻ (C1). Chỉ api/index.ts nạp SDK.
#
# --- Backup đêm (D11: export sang GitHub, storage khác vendor) ---
# CRON_SECRET     = chuỗi ngẫu nhiên dài; Vercel tự chèn vào header khi gọi cron.
#                   Endpoint /internal/backup so khớp secret này. (Đặt trên Vercel.)
# BACKUP_GH_TOKEN = fine-grained PAT, CHỈ quyền Contents:Read+Write trên đúng repo backup
# BACKUP_GH_REPO  = owner/repo của repo backup PRIVATE, vd <owner>/<backup-repo>
# BACKUP_GH_BRANCH= nhánh đẩy backup (mặc định "main")
# BACKUP_KHOA     = khoá AES-256-GCM của bản sao lưu (B2, D613): 32 byte base64. BÍ MẬT.
#                   Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#                   Đặt trên Vercel (backup đêm) VÀ trong .env máy founder (npm run khoi-phuc đọc tệp .enc).
#                   ⚠ Vắng ⇒ /internal/backup 501, KHÔNG BAO GIỜ đẩy bản trần. Mất khoá = mất mọi bản sao lưu.
#
# .env.prod (gitignored, dùng cho `npm run backup:push` chạy tay) cần thêm:
#   BACKUP_GH_TOKEN, BACKUP_GH_REPO, BACKUP_KHOA (và BACKUP_GH_BRANCH nếu khác main)
#
# --- TLS tới Supabase (B3, D613) ---
# DATABASE_SSL_CA = (tuỳ chọn) nội dung PEM CA thay cho CA ghim ở config/supabase_ca.ts — chỉ khi Supabase đổi CA.
#                   Kết nối Supabase luôn kiểm chứng chỉ; `sslmode=…` trong DATABASE_URL bị bỏ qua (server/db.ts).
#
# --- Thư (B10, D613) ---
# SMTP_URL        = BẮT BUỘC ở mọi môi trường triển khai (APP_ENV=production · VERCEL=1 · NODE_ENV=production) —
#                   thiếu thì API ném lỗi lúc khởi động. Máy dev thiếu ⇒ in thư ra console (chỉ người nhận + tiêu đề).

# ── CỬA DISCORD (bản yêu cầu 02) ─────────────────────────────────────────────
# DISCORD_CLIENT_ID     = Application ID, lấy ở Developer Portal. KHÔNG phải bí mật.
# DISCORD_CLIENT_SECRET = BÍ MẬT. Chỉ đặt trong biến môi trường trên Vercel.
#   ⚠ Xuất hiện trong chat/báo cáo/file ngoài env = COI NHƯ ĐÃ LỘ, phải xoay lại
#   ngay (D17e). Không bao giờ dán nguyên chuỗi vào bất cứ đâu.
#   ⚠ VẮNG HAI BIẾN NÀY thì cửa Discord ĐÓNG (trả 503) chứ không mở toang —
#   fail-closed, cùng kỷ luật với CORS của D57.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# PROXY_SHARED_SECRET — BÍ MẬT DÙNG CHUNG giữa Cloudflare Worker và API.
#
# ⚠ PHẢI ĐẶT Ở CẢ HAI PHÍA, GIỐNG HỆT NHAU:
#     · Vercel  : biến môi trường PROXY_SHARED_SECRET (rồi deploy lại)
#     · Worker  : wrangler secret put PROXY_SHARED_SECRET
#
# ⚠⚠ VÌ SAO NÓ ĐƯỢC GHI Ở ĐÂY (bổ sung 11/08): trước hôm nay biến này được ĐỌC
# ở đúng hai chỗ (api/index.ts, web/worker/index.js) và KHÔNG được khai ở bất kỳ
# đâu — không .env.example, không docs, không README. Cả hai phía đều bọc
# `if (secret)` nên thiếu nó là hỏng IM LẶNG, và ai dựng lại môi trường sẽ không
# có cách nào biết là mình đang thiếu.
#
# Nó chống lưng cho BA thứ:
#   0. CỔNG PROXY (B1, 17/10): API có biến này ⇒ mọi /api/* thiếu header secret bị 403 `khong_qua_cong` (trừ
#      /api/v1/health thân tối thiểu + /api/v1/internal/*). Lệch secret hai phía = khoá cả app — kiểm trước deploy
#      (docs/deploy_gd0.md Bước 6c).
#   1. IP thật cho rate limit đăng ký (Vercel ghi đè x-forwarded-for bằng IP edge
#      Cloudflare — sự cố 18/07, cả một PoP dùng chung một bucket).
#   2. Cửa ngoài khu admin: allowlist IP chỉ có nghĩa khi máy chủ biết IP nào
#      đáng tin. Thiếu secret ⇒ allowlist KHÔNG BAO GIỜ xác thực được ai.
#
# Kiểm nhanh sau khi đặt — gọi qua GỐC WORKER (không phải gốc API), kèm
# header bí mật (D444: hai khoá dưới nằm ở phần CHI TIẾT của /health, đọc
# bằng TICK_SECRET — không phải PROXY_SHARED_SECRET, xem server/app.ts):
#     curl -s -H "x-tick-secret: <TICK_SECRET>" https://<worker>/api/v1/health
#   · proxy_secret_cau_hinh: true   ⇒ phía API đã có biến
#   · admin_allowlist.tin_duoc_ip: true ⇒ hai phía KHỚP nhau
# Gọi thẳng gốc API thì tin_duoc_ip luôn false theo đúng định nghĩa — đó là
# phép đo SAI TRƯỜNG, đừng dùng nó để kết luận là hỏng.
PROXY_SHARED_SECRET=

# ── GHÉP BÀN XẾP HẠNG ≥ 4 NGƯỜI THẬT (SPEC alpha-draft-tang-khong-gian mục 6; migration 0078) ─────────
# RANK_GHEP_BAT=1 bật suất đấu 15 phút + ghép bàn. TẮT mặc định — KHÔNG đặt trên prod khi chưa được founder gật.
#   Bật ⇒ `rank_pve` (xếp hạng 1 người + máy) bị đóng, xếp hạng chỉ qua suất đấu.
RANK_GHEP_BAT=
# Bí mật trộn bàn (design_rank §7.5): chia bàn = f(đăng ký, điểm ghép, HASH(slot_id + secret)). CHỈ ở env server; client không có.
# Thiếu hoặc < 8 ký tự ⇒ fail-closed: tick KHÔNG ghép bàn nào (thà chờ còn hơn để chỗ ngồi đoán được).
SLOT_SHUFFLE_SECRET=
